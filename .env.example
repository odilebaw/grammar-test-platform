# ══════════════════════════════════════════════════════════════════════
# Grammatika Test Platform — Muhit O'zgaruvchilari
# ══════════════════════════════════════════════════════════════════════
#
# FOYDALANISH:
#   1. Ushbu faylni nusxalang:  cp .env.example .env
#   2. .env faylini tahrirlang va o'z qiymatlaringizni kiriting
#   3. .env fayli hech qachon git ga yuklanmasin (.gitignore ga qo'shilgan)
#
# PythonAnywhere da:
#   Web sahifasi → "Environment variables" bo'limiga qo'lda kiriting
# ══════════════════════════════════════════════════════════════════════


# ── Flask konfiguratsiya ──────────────────────────────────────────────

# Muhit turi: development | production | testing
FLASK_CONFIG=production

# Maxfiy kalit — sessiyalar va cookie larni himoyalash uchun
# MUHIM: Kamida 32 ta tasodifiy belgi. Hech qachon standart qiymatni ishlatmang!
# Yangi kalit yaratish: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SHUNING-UCHUN-TASODIFIY-KALIT-YARATING-python-c-import-secrets-print-secrets-token-hex-32

# CSRF himoyasi uchun alohida maxfiy kalit
# Yangi kalit: python -c "import secrets; print(secrets.token_hex(24))"
WTF_CSRF_SECRET_KEY=CSRF-UCHUN-HAM-ALOHIDA-TASODIFIY-KALIT


# ── Ma'lumotlar bazasi ────────────────────────────────────────────────

# SQLite — PythonAnywhere Free tarif uchun to'g'ri yo'lni ko'rsating
# PythonAnywhere da: sqlite:////home/YOUR_USERNAME/grammar-test-platform/grammar_test.db
# Lokal: sqlite:///grammar_test.db   (nisbiy yo'l, loyiha papkasida yaratiladi)
DATABASE_URL=sqlite:///grammar_test.db


# ── Gemini AI API ─────────────────────────────────────────────────────

# Google Gemini API kaliti — bepul olish: https://aistudio.google.com/app/apikey
# AI savol generatori ishlaши учун MAJBURIY
GEMINI_API_KEY=your-gemini-api-key-here

# Muqobil nom (agar GEMINI_API_KEY ishlamasa)
# GOOGLE_API_KEY=your-google-api-key-here


# ── Ilovaga xos sozlamalar ────────────────────────────────────────────

# Har bir testda ko'rsatiladigan savollar soni (standart: 20)
# QUESTIONS_PER_TEST=20

# Test vaqt chegarasi daqiqalarda (standart: 20)
# TEST_TIME_LIMIT_MINUTES=20
